# =============================================================================
# RemoteRecruit — server (backend) environment template
# Copy this file to `.env` and fill in your values. `.env` is gitignored.
# =============================================================================

# --- Database ----------------------------------------------------------------
# MongoDB Atlas connection string.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/remote_recruit?retryWrites=true&w=majority

# Secret used to sign JWT tokens. Change this in production.
JWT_SECRET=change_me_in_production

# Server port
PORT=5000

# --- Email verification (Nodemailer + Gmail SMTP) -----------------------------
# Emails are sent from a dedicated Gmail account using an "App Password":
#   EMAIL_USER=you@gmail.com
#   EMAIL_PASS=your_16_char_app_password
# Create the app password at https://myaccount.google.com/apppasswords
# (2-step verification must be enabled). Use the app password, NOT your Gmail
# login password. With these set, the mailer uses smtp.gmail.com:587 by default.


# Optional overrides. Only needed for non-Gmail providers or local development:
# for local testing you can point at the included mail sink
# (server/scripts/dev-mail-server.mjs) instead, e.g.
#   SMTP_HOST=localhost
#   SMTP_PORT=1025
#   SMTP_SECURE=false
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false

# Sender display name / address (defaults to RemoteRecruit <EMAIL_USER>).
# SMTP_FROM="RemoteRecruit" <no-reply@remoterecruit.com>

# Public base URL used to build the verification link (defaults to localhost:5173).
# FRONTEND_URL=http://localhost:5173
